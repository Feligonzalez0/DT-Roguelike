<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Carrera finalizada - DT Roguelike</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

{{#careerOver}}

<main class="page">

    <header class="season-summary-header">
        <div>
            <p class="season-label">CARRERA FINALIZADA</p>
            <h1>Tu carrera ha llegado a su fin</h1>

            <p class="muted">
                {{managerName}}
            </p>
        </div>

        <div class="phase-badge">
            FIN DE CARRERA
        </div>
    </header>


    <section class="season-summary-hero">

        <p class="season-label">
            CARRERA FINALIZADA
        </p>

        <h2>
            Ningún club está interesado en contratarte.
        </h2>

        <p class="season-summary-assessment">
            Tu carrera como Director Técnico ha llegado a su fin.
        </p>

    </section>


    <section class="card season-summary-card">

        <div class="summary-card-header">
            <div>
                <p class="season-label">
                    MOTIVO
                </p>

                <h2>
                    {{endReason}}
                </h2>
            </div>
        </div>

    </section>


    <section class="card season-summary-card">

        <div class="summary-card-header">
            <div>
                <p class="season-label">
                    ÚLTIMA TEMPORADA
                </p>

                <h2>
                    Temporada {{finalSeason}}
                </h2>
            </div>
        </div>

        <div class="season-summary-stats">

            <div class="season-stat">
                <span class="season-stat-value">
                    {{finalReputation}}
                </span>

                <span class="season-stat-label">
                    REPUTACIÓN FINAL
                </span>
            </div>

            <div class="season-stat">
                <span class="season-stat-value">
                    {{lastClubName}}
                </span>

                <span class="season-stat-label">
                    ÚLTIMO CLUB
                </span>
            </div>

            <div class="season-stat">
                <span class="season-stat-value">
                    {{finalSeason}}
                </span>

                <span class="season-stat-label">
                    TEMPORADA FINAL
                </span>
            </div>

        </div>

    </section>


    <section class="season-summary-actions">

        <form action="/career/create" method="get">
            <button class="btn btn-primary" type="submit">
                Iniciar nueva carrera
            </button>
        </form>

    </section>

</main>

{{/careerOver}}

</body>
</html>