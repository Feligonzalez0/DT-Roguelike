<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nueva temporada - DT Roguelike</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

{{#preseasonEvent}}

<main class="page">

    <header class="page-header">
        <p class="season-label">NUEVA TEMPORADA</p>
        <h1>{{title}}</h1>
        <p>{{description}}</p>
        <p class="muted">¿En qué querés enfocarte esta pretemporada?</p>
    </header>

    <div class="offers-grid preseason-options">

        {{#options}}

        <div class="card offer-card preseason-option-card">

            <div class="preseason-option-card__content">

                <h2 class="preseason-option-card__attribute">
                    {{attributeName}}
                </h2>

                <p class="preseason-option-card__description">
                    {{description}}
                </p>

                <p class="preseason-option-card__effect">
                    +{{delta}} {{attributeName}}
                </p>

                <form action="/career/preseason" method="post">

                    <input type="hidden" name="optionId" value="{{id}}">

                    <button class="btn btn-primary" type="submit">
                        Elegir
                    </button>

                </form>

            </div>

        </div>

        {{/options}}

    </div>

</main>

{{/preseasonEvent}}

</body>
</html>
