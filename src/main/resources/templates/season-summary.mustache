<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Resumen de temporada - DT Roguelike</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .season-summary-header { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:20px; }
        .season-summary-header h1 { margin:0 0 4px; font-size:2rem; }
        .season-summary-hero { background:var(--card-bg); border:1px solid var(--border); border-radius:14px; padding:32px 24px; margin-bottom:16px; text-align:center; box-shadow:0 4px 16px rgba(0,0,0,.18); }
        .season-summary-hero h2 { margin:10px 0 6px; font-size:1.5rem; }
        .season-summary-position { display:flex; flex-direction:column; align-items:center; gap:2px; }
        .summary-position-value { font-size:4rem; line-height:1; font-weight:800; color:var(--accent); }
        .summary-position-label { color:var(--muted); font-size:.8rem; font-weight:700; letter-spacing:.08em; }
        .season-summary-assessment { max-width:560px; margin:10px auto 0; color:var(--muted); }
        .season-summary-card { margin-bottom:16px; }
        .summary-card-header { margin-bottom:16px; }
        .summary-card-header h2 { margin:0; font-size:1.2rem; }
        .season-summary-stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; }
        .season-summary-table-wrapper { overflow-x:auto; }
        .season-summary-table { width:100%; border-collapse:collapse; min-width:420px; }
        .season-summary-table th,.season-summary-table td { padding:11px 12px; border-bottom:1px solid var(--border); text-align:center; white-space:nowrap; }
        .season-summary-table th { color:var(--muted); font-size:.75rem; letter-spacing:.05em; }
        .season-summary-table th:nth-child(2),.season-summary-table td:nth-child(2) { text-align:left; }
        .season-summary-table tbody tr:last-child td { border-bottom:none; }
        .season-summary-table tr.managed-club td { font-weight:700; }
        .season-summary-actions { display:flex; justify-content:center; margin-top:24px; }
        .season-summary-actions .btn { min-width:220px; }
        .summary-empty { margin:0; text-align:center; padding:12px 0; }
        @media (max-width:650px) {
            .season-summary-header { flex-direction:column; }
            .season-summary-header .phase-badge { align-self:flex-start; }
            .season-summary-hero { padding:26px 18px; }
            .summary-position-value { font-size:3.4rem; }
            .season-summary-stats { grid-template-columns:repeat(2,minmax(0,1fr)); }
        }
    </style>
</head>

<body>
{{#summary}}
<main class="page season-summary-page">

    <header class="season-summary-header">
        <div>
            <p class="season-label">RESUMEN DE TEMPORADA</p>
            <h1>Temporada {{seasonYear}}</h1>
            <p class="muted">{{clubName}} · Dirigido por {{managerName}}</p>
        </div>

        <div class="phase-badge">
            {{phase}}
        </div>
    </header>

    <section class="season-summary-hero">
        <p class="season-label">TEMPORADA FINALIZADA</p>

        <div class="season-summary-position">
            <span class="summary-position-value">{{finalPosition}}</span>
            <span class="summary-position-label">{{finalPositionLabel}}</span>
        </div>

        <h2>{{clubName}}</h2>
        <p class="season-summary-assessment">{{seasonAssessment}}</p>
    </section>

    <section class="card season-summary-card">
        <div class="summary-card-header">
            <div>
                <p class="season-label">RENDIMIENTO</p>
                <h2>Estadísticas de la temporada</h2>
            </div>
        </div>

        <div class="season-summary-stats">
            <div class="season-stat"><span class="season-stat-value">{{matchesPlayed}}</span><span class="season-stat-label">PJ</span></div>
            <div class="season-stat"><span class="season-stat-value">{{wins}}</span><span class="season-stat-label">PG</span></div>
            <div class="season-stat"><span class="season-stat-value">{{draws}}</span><span class="season-stat-label">PE</span></div>
            <div class="season-stat"><span class="season-stat-value">{{losses}}</span><span class="season-stat-label">PP</span></div>
            <div class="season-stat"><span class="season-stat-value">{{goalsFor}}</span><span class="season-stat-label">GF</span></div>
            <div class="season-stat"><span class="season-stat-value">{{goalsAgainst}}</span><span class="season-stat-label">GC</span></div>
            <div class="season-stat"><span class="season-stat-value">{{goalDifference}}</span><span class="season-stat-label">DG</span></div>
            <div class="season-stat season-points"><span class="season-stat-value">{{points}}</span><span class="season-stat-label">PTS</span></div>
        </div>
    </section>

    <section class="card season-summary-card">
        <div class="summary-card-header">
            <div>
                <p class="season-label">CLASIFICACIÓN</p>
                <h2>Tabla final</h2>
            </div>
        </div>

        <div class="season-summary-table-wrapper">
            <table class="season-summary-table">
                <thead>
                <tr>
                    <th>POS</th>
                    <th>CLUB</th>
                    <th>PJ</th>
                    <th>DG</th>
                    <th>PTS</th>
                </tr>
                </thead>
                <tbody>
                {{#standings}}
                <tr class="{{#isManagedClub}}managed-club{{/isManagedClub}}">
                    <td>{{position}}</td>
                    <td>{{clubName}}</td>
                    <td>{{played}}</td>
                    <td>{{goalDifference}}</td>
                    <td><strong>{{points}}</strong></td>
                </tr>
                {{/standings}}
                </tbody>
            </table>
        </div>
    </section>

    <section class="card season-summary-card">
        <div class="summary-card-header">
            <div>
                <p class="season-label">CIERRE</p>
                <h2>Últimos resultados</h2>
            </div>
        </div>

        <div class="recent-fixture-list">
            {{#recentMatches}}
            <div class="fixture-match {{resultClass}}">
                <div class="fixture-round">
                    Fecha {{round}}
                </div>
                <div class="fixture-match-info">
                    <div class="fixture-opponent">vs {{opponent}}</div>
                    <div class="fixture-home-away">{{homeAway}}</div>
                </div>
                <div class="fixture-result">{{result}}</div>
            </div>
            {{/recentMatches}}

            {{^recentMatches}}
            <p class="muted summary-empty">No hay resultados disponibles.</p>
            {{/recentMatches}}
        </div>
    </section>

    <section class="season-summary-actions">
        <form action="/career/season/next" method="post">
            <button class="btn btn-primary" type="submit">
                Continuar carrera
            </button>
        </form>
    </section>

</main>
{{/summary}}
</body>
</html>
