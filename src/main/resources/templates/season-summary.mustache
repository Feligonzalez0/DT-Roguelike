<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Resumen de temporada - DT Roguelike</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
{{#summary}}
<main class="page season-summary-page">

    <header class="season-summary-header">
        <div>
            <p class="season-label">RESUMEN DE TEMPORADA</p>
            <h1>Temporada {{seasonYear}}</h1>
            <p class="muted">{{clubName}} · Dirigido por {{managerName}}</p>
        </div>

        <div class="phase-badge">
            {{phase}}
        </div>
    </header>

    <!-- HERO DE TEMPORADA -->
    <section class="season-summary-hero {{#champion}}champion{{/champion}}">
        <p class="season-label">TEMPORADA FINALIZADA</p>

        <div class="season-summary-position">
            {{#champion}}
                <span class="summary-position-value">¡CAMPEÓN!</span>
            {{/champion}}

            {{^champion}}
                <span class="summary-position-value">{{finalPositionLabel}}</span>
                <span class="summary-position-label">POSICIÓN FINAL</span>
            {{/champion}}
        </div>

        <h2>{{clubName}}</h2>

        <p class="season-summary-assessment">
            {{seasonAssessment}}
        </p>
    </section>
    
    <!-- OBJETIVO DE TEMPORADA -->
    <section class="card season-summary-objective
        {{#objectiveCompleted}}objective-completed{{/objectiveCompleted}}
        {{^objectiveCompleted}}objective-failed{{/objectiveCompleted}}">

        <div class="summary-card-header">
            <div>
                <p class="season-label">OBJETIVO DE TEMPORADA</p>
                <h2>{{objectiveStatus}}</h2>
            </div>
        </div>

        <div class="season-objective-content">

            <p class="season-objective-description">
                {{objectiveDescription}}
            </p>

            <p class="season-objective-message">
                {{objectiveResultMessage}}
            </p>

        </div>

    </section>
    <!-- CONTINUAR CARRERA -->
    <section class="season-summary-actions">
        <form action="/career/season/next" method="post">
            <button class="btn btn-primary" type="submit">
                Continuar carrera
            </button>
        </form>
    </section>

    <!-- ESTADÍSTICAS -->
    <section class="card season-summary-card">
        <div class="summary-card-header">
            <div>
                <p class="season-label">RENDIMIENTO</p>
                <h2>Estadísticas de la temporada</h2>
            </div>
        </div>

        <div class="season-summary-stats">

            <div class="season-stat">
                <span class="season-stat-value">{{matchesPlayed}}</span>
                <span class="season-stat-label">PJ</span>
            </div>

            <div class="season-stat">
                <span class="season-stat-value">{{wins}}</span>
                <span class="season-stat-label">PG</span>
            </div>

            <div class="season-stat">
                <span class="season-stat-value">{{draws}}</span>
                <span class="season-stat-label">PE</span>
            </div>

            <div class="season-stat">
                <span class="season-stat-value">{{losses}}</span>
                <span class="season-stat-label">PP</span>
            </div>

            <div class="season-stat">
                <span class="season-stat-value">{{goalsFor}}</span>
                <span class="season-stat-label">GF</span>
            </div>

            <div class="season-stat">
                <span class="season-stat-value">{{goalsAgainst}}</span>
                <span class="season-stat-label">GC</span>
            </div>

            <div class="season-stat">
                <span class="season-stat-value">{{goalDifference}}</span>
                <span class="season-stat-label">DG</span>
            </div>

            <div class="season-stat season-points">
                <span class="season-stat-value">{{points}}</span>
                <span class="season-stat-label">PTS</span>
            </div>

        </div>
    </section>

    <!-- TABLA FINAL -->
    <section class="card season-summary-card">
        <div class="summary-card-header">
            <div>
                <p class="season-label">CLASIFICACIÓN</p>
                <h2>Tabla final</h2>
            </div>
        </div>

        <div class="season-summary-standings">

            <!--
                Toggle puramente visual.
                No modifica ninguna lógica del juego.
            -->
            <input
                type="checkbox"
                id="standings-toggle"
                class="standings-toggle"
            >

            <div class="season-summary-table-wrapper">
                <table class="season-summary-table">

                    <thead>
                    <tr>
                        <th>POS</th>
                        <th>CLUB</th>
                        <th>PJ</th>
                        <th>DG</th>
                        <th>PTS</th>
                    </tr>
                    </thead>

                    <tbody>
                    {{#standings}}
                    <tr class="{{#isManagedClub}}managed-club{{/isManagedClub}}">
                        <td>{{position}}</td>
                        <td>{{clubName}}</td>
                        <td>{{played}}</td>
                        <td>{{goalDifference}}</td>
                        <td><strong>{{points}}</strong></td>
                    </tr>
                    {{/standings}}
                    </tbody>

                </table>
            </div>

            <label for="standings-toggle" class="standings-toggle-label">
                <span class="standings-toggle-more">
                    ＋ Ver tabla completa
                </span>

                <span class="standings-toggle-less">
                    − Ocultar tabla completa
                </span>
            </label>

        </div>
    </section>

    <!-- ÚLTIMOS RESULTADOS -->
    <section class="card season-summary-card">
        <div class="summary-card-header">
            <div>
                <p class="season-label">CIERRE</p>
                <h2>Últimos resultados</h2>
            </div>
        </div>

        <div class="recent-fixture-list">

            {{#recentMatches}}
            <div class="fixture-match {{resultClass}}">

                <div class="fixture-round">
                    Fecha {{round}}
                </div>

                <div class="fixture-match-info">
                    <div class="fixture-opponent">
                        vs {{opponent}}
                    </div>

                    <div class="fixture-home-away">
                        {{homeAway}}
                    </div>
                </div>

                <div class="fixture-result">
                    {{result}}
                </div>

            </div>
            {{/recentMatches}}

            {{^recentMatches}}
            <p class="muted summary-empty">
                No hay resultados disponibles.
            </p>
            {{/recentMatches}}

        </div>
    </section>

</main>
{{/summary}}
</body>
</html>