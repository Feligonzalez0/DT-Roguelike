<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ofertas de clubes - DT Roguelike</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<main class="page">
    <header class="page-header">
        <h1>Ofertas para {{managerName}}</h1>
        <p>Elegí el club en el que vas a empezar tu carrera.</p>
    </header>

    <div class="offers-grid">
        {{#offers}}
        <div class="card offer-card">
            <h2>{{clubName}}</h2>
            <p class="muted">{{league}} · Reputación {{reputation}}</p>
            <ul class="offer-details">
                <li>Salario: ${{salary}}</li>
                <li>Contrato: {{contractLengthYears}} año(s)</li>
                <li>Seguridad laboral: {{jobSecurity}}/100</li>
                <li>Posición mínima esperada: {{minimumExpectedPosition}}</li>
                {{#expectedToWinLeague}}<li>Se espera ganar el campeonato</li>{{/expectedToWinLeague}}
            </ul>
            <form action="/career/club/select" method="post">
                <input type="hidden" name="clubId" value="{{clubId}}">
                <button class="btn btn-primary" type="submit">Elegir {{clubName}}</button>
            </form>
        </div>
        {{/offers}}
    </div>
</main>
</body>
</html>
